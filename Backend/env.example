# Copy this file to ".env" and fill in your own values.
# The .env file is private and must NOT be committed to git.

# PostgreSQL connection (async driver). Replace the password and, if needed, the
# database name. Create the database first (see the README).
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5432/stockpilot

# Secret used to sign JWTs. Generate a fresh one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_64_char_hex_string

# Token settings (defaults are fine for local development)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1
